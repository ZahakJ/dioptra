{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dioptra",
  "version": "0.4.0",
  "identifier": "io.github.zahakj.dioptra",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5760",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dioptra",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Data, statistics and publication graphs without the spreadsheet.",
    "longDescription": "Dioptra is a cross-platform replacement for GraphPad Prism and the spreadsheet before it: paste raw data, shape it with formulas, run honest statistical tests, and export publication-ready figures.",
    "linux": { "deb": { "depends": [] }, "rpm": { "depends": [] } },
    "macOS": { "minimumSystemVersion": "10.15", "signingIdentity": "-", "hardenedRuntime": false },
    "windows": { "wix": { "language": "en-US" }, "nsis": { "installMode": "currentUser" } }
  }
}
